# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kpatrol?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Redis (for Socket.io scaling)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL=debug

# Robot device API key — Pi/firmware uses this to authenticate the Socket.IO
# handshake (type=robot). Generate with `openssl rand -hex 32`. Required in
# production; dev mode falls back to "dev-robot-key" with a startup warning.
ROBOT_API_KEY=

# MJPEG stream token signing secret — backend signs short-TTL JWTs that the
# operator's browser passes to the Pi's mjpeg_server. Pi must hold the same
# value to verify. Generate with `openssl rand -hex 32`. Required in
# production; dev mode falls back to a known string with a startup warning.
STREAM_TOKEN_SECRET=

# Email (SMTP) — leave SMTP_HOST empty to disable email channel
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="K-Patrol Alerts <noreply@kpatrol.local>"

# Zalo Official Account — leave ZALO_OA_TOKEN empty to disable Zalo channel
ZALO_OA_TOKEN=
ZALO_API_BASE=https://openapi.zalo.me/v3.0/oa

# Alert broadcast — admin recipients receive every "alert"-severity event in
# addition to the per-user DB record. Comma-separated, blank disables.
ALERT_RECIPIENTS_EMAIL=
ALERT_RECIPIENTS_ZALO=

# MQTT broker — backend subscribes to "${MQTT_TOPIC_PREFIX}/+/alert" for
# detection events emitted by robots' alert_bridge.py. Leave MQTT_HOST empty
# to soft-disable ingest (no broker connection attempted). Production must set
# host + credentials.
MQTT_HOST=
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=kpatrol
