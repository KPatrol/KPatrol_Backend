// Prisma Schema for K-Patrol Backend
// Updated: 2026-03 - V8 with RobotEvent, Notification, Patrol, PatrolLog

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  robots        Robot[]
  authSessions  AuthSession[]
  notifications Notification[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])  // For expired session cleanup
}

enum Role {
  USER
  ADMIN
}

// ==================== ROBOT ====================

model Robot {
  id           String      @id @default(cuid())
  name         String
  serialNumber String      @unique
  status       RobotStatus @default(OFFLINE)
  userId       String
  batteryLevel Float?
  lastSeen     DateTime?
  // V8: Safety thresholds stored per-robot
  safetyEnabled        Boolean @default(true)
  dangerDistance       Int     @default(150)
  cautionDistance      Int     @default(250)
  slowDistance         Int     @default(500)
  // V8: Speed config
  defaultSpeed         Int     @default(150)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Restrict: deleting a user must not silently destroy owned robots —
  // transfer ownership first.
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions     RobotSession[]
  patrols      Patrol[]
  alerts       Alert[]
  events       RobotEvent[]
  telemetry    Telemetry[]
}

enum RobotStatus {
  ONLINE
  OFFLINE
  CHARGING
  ERROR
}

model RobotSession {
  id        String    @id @default(cuid())
  robotId   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  distance  Float     @default(0)

  robot     Robot     @relation(fields: [robotId], references: [id], onDelete: Cascade)
  logs      PatrolLog[]
}

// ==================== PATROL ====================

model Patrol {
  id        String   @id @default(cuid())
  robotId   String
  name      String
  status    String   @default("PENDING")
  routeData Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  robot     Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  logs      PatrolLog[]
}

model PatrolLog {
  id        String    @id @default(cuid())
  patrolId  String?
  sessionId String?
  logType   String
  message   String
  data      Json?
  createdAt DateTime  @default(now())

  patrol    Patrol?       @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  session   RobotSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ==================== ROBOT EVENTS (Activity History) ====================

model RobotEvent {
  id          String   @id @default(cuid())
  robotId     String
  // 'movement' | 'alert' | 'system' | 'patrol' | 'connection' | 'error'
  eventType   String
  title       String
  description String
  // 'info' | 'success' | 'warning' | 'error'
  severity    String   @default("info")
  data        Json?
  createdAt   DateTime @default(now())

  robot       Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@index([robotId, createdAt])
  @@index([robotId, eventType])
}

// ==================== TELEMETRY ====================

model Telemetry {
  id           String   @id @default(cuid())
  robotId      String
  timestamp    DateTime @default(now())

  batteryLevel Float?
  temperature  Float?
  cpuUsage     Float?
  memoryUsage  Float?

  positionX    Float?
  positionY    Float?
  heading      Float?

  speedM1      Float?
  speedM2      Float?
  speedM3      Float?
  speedM4      Float?

  // V8: ToF distances (mm)
  tofFront       Float?
  tofFrontLeft   Float?
  tofFrontRight  Float?
  tofLeft        Float?
  tofRight       Float?
  tofBack        Float?

  // V8: IMU
  imuYaw     Float?
  imuPitch   Float?
  imuRoll    Float?

  robot        Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@index([robotId, timestamp])
  @@index([timestamp])  // For cron cleanup by age
}

// ==================== ALERTS ====================

model Alert {
  id             String        @id @default(cuid())
  robotId        String
  type           AlertType
  message        String
  severity       AlertSeverity @default(INFO)
  acknowledged   Boolean       @default(false)
  acknowledgedAt DateTime?
  data           Json?
  // V10: detection-specific fields persisted from MQTT ingest. Confidence and
  // bbox are denormalised out of `data` so admin queries (e.g. "average
  // confidence of fire alerts last week") don't have to JSON-parse every row.
  confidence     Float?
  bboxX          Int?
  bboxY          Int?
  bboxW          Int?
  bboxH          Int?
  frameWidth     Int?
  frameHeight    Int?
  // Base64 JPEG snapshot. Stored inline so the web admin can render the alert
  // without a follow-up fetch; ~6–10 KB per row at 320 px / q70 — acceptable.
  snapshotB64    String?
  // External alert id from the robot's local SQLite WAL, used to deduplicate
  // re-publishes when the drainer retries after broker reconnects.
  externalId     Int?
  createdAt      DateTime      @default(now())

  robot          Robot         @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@unique([robotId, externalId])
  @@index([robotId, acknowledged])
  @@index([acknowledged, createdAt])  // For cron cleanup of old acknowledged alerts
  @@index([robotId, type, createdAt])  // Web admin filters by alert type per robot
}

enum AlertType {
  MOTION_DETECTED
  LOW_BATTERY
  CONNECTION_LOST
  OBSTACLE_DETECTED
  SYSTEM_ERROR
  SAFETY_DANGER
  SAFETY_CAUTION
  IMU_ERROR
  // V10: emitted by AnomalyDetector → alert_bridge → MQTT → MqttIngestService.
  PERSON_DETECTED
  FIRE_DETECTED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
